# Copy to .env.local (gitignored) for local dev. All values here are PUBLIC by design.
# Never put a Supabase service-role key, DB password, or any secret in this app.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-or-publishable-key>
VITE_GOOGLE_CLIENT_ID=<web-client-id>.apps.googleusercontent.com
